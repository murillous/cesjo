# Variáveis da implantação do CESJO SGI (issue #20, ADR 0052).
# Copie para deploy/.env (ignorado pelo git), preencha e proteja: chmod 600 .env
# Nunca faça commit do .env. Guarde uma cópia dos segredos fora da VPS (ver docs/implantacao.md).
# Todos os valores abaixo são exemplos fictícios.

# --- Domínio e TLS (Caddy) ---
# PENDENTE-CESJO(P15): domínio ainda não definido pela equipe CESJO (ADR 0050).
# Nome público do sistema; o DNS (registro A/AAAA) precisa apontar para a VPS antes da subida.
# Use "localhost" para testar numa máquina local (certificado da CA interna do Caddy).
SGI_DOMINIO=sgi.exemplo.org.br
# E-mail de contato para o Let's Encrypt (avisos de expiração do certificado).
SGI_ACME_EMAIL=ti@exemplo.org.br

# --- Banco (Postgres 18) ---
POSTGRES_DB=cesjo
POSTGRES_USER=cesjo
# Gere com: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# --- Criptografia AES-256-GCM (ADR 0004 e ADR 0025) ---
# Identificador da chave que cifra valores novos. Só letras minúsculas e dígitos.
SGI_CRIPTOGRAFIA_CHAVEATIVA=prod1
# Uma variável por chave: SGI_CRIPTOGRAFIA_CHAVES_<ID em maiúsculas>, 32 bytes em Base64.
# Gere com: openssl rand -base64 32
# Na rotação, acrescente a chave nova (por exemplo SGI_CRIPTOGRAFIA_CHAVES_PROD2), aponte a chave
# ativa para ela e mantenha a antiga enquanto houver dado cifrado com ela.
# Sem a chave, banco e arquivos ficam ilegíveis, inclusive no backup.
SGI_CRIPTOGRAFIA_CHAVES_PROD1=

# --- Primeira conta de Coordenador (ADR 0014) ---
# Usada só quando o banco não tem nenhuma conta. Depois da primeira subida pode ser apagada daqui.
# Login: 3 a 60 caracteres entre letras sem acento, números, ".", "-" e "_".
SGI_COORDENADOR_LOGIN=coordenacao
# Senha inicial com pelo menos 12 caracteres; o sistema pede a troca no primeiro acesso.
SGI_COORDENADOR_SENHA=troque-esta-senha-inicial
SGI_COORDENADOR_NOME=Coordenação

# --- Imagens (opcional) ---
# Por padrão o compose constrói as imagens na VPS a partir do repositório.
# Para usar imagens já publicadas num registro, informe o nome completo com a tag.
# SGI_IMAGEM_APP=cesjo-sgi-backend:local
# SGI_IMAGEM_CADDY=cesjo-sgi-caddy:local
